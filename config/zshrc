_zs_preexec() {
  # wtf/explain/zagent talk ABOUT the previous command — don't let them replace it,
  # so `?? why did that fail` still sees the command that actually failed as context.
  [[ $1 == (wtf|wtf\ -r|explain\ *|\ explain\ *|zagent*|\ zagent*) ]] && return 0
  _ZS_PREV_CMD=$_ZS_LAST_CMD; _ZS_LAST_CMD=$1
  _ZS_CMD_RAN=1; _ZS_CMD_T0=$EPOCHREALTIME
}
_zs_precmd() {
  local st=$?
  (( $+functions[_zs_watch_note] )) && _zs_watch_note   # summary from a job that finished while you were away
  (( _ZS_CMD_RAN )) || return 0          # zsh-defer fires precmd hooks too; ignore those
  _ZS_CMD_RAN=0; _ZS_LAST_STATUS=$st
  local -F dur=$(( EPOCHREALTIME - _ZS_CMD_T0 ))
  (( $+functions[_zs_watch_check] )) && _zs_watch_check $st $dur
  # ?? proposed this command and it just ran: tell the next ?? turn what happened
  # (must live here, not a separate hook — $? is only correct in the FIRST precmd hook)
  if [[ -n $_ZS_AIPROP && $_ZS_LAST_CMD == "$_ZS_AIPROP"* ]]; then
    local _aiout=''
    (( ${ZSH_AGENT_SCREEN:-1} )) && (( $+functions[_zs_tab_output] )) && _aiout=$(_zs_tab_output 2>/dev/null | tail -n 30)
    (( $+commands[jq] )) && jq -nc --arg c "$_ZS_LAST_CMD" --argjson s $st --arg o "$_aiout" --argjson t $EPOCHSECONDS \
      '{command:$c, status:$s, output:$o, t:$t}' 2>/dev/null | _zs_write_atomic $ZSH_CACHE/agent-feedback.json
    _ZS_AIPROP=''
  fi
  if (( ZSH_NOTIFY_AFTER > 0 && dur >= ZSH_NOTIFY_AFTER )); then
    print -n -- "\e]9;${_ZS_LAST_CMD[1,60]} · ${dur%.*}s · exit $st\a"
  fi
  (( st == 0 || st == 130 || st == 146 || st == 148 || ! ZSH_FAIL_HINT )) && return 0
  case ${${(z)_ZS_LAST_CMD}[1]} in
    grep|rg|diff|cmp|test|\[|false|wtf|ai) return 0 ;;   # routine non-zero exits
  esac
  local -i n=0
  [[ -r $ZSH_DATA/hint-count ]] && n=$(<$ZSH_DATA/hint-count)
  if (( n < 12 )); then
    print -P -- "%F{$ZC[dim]}  ↳ exit $st · %Bwtf%b explains it · Ctrl+X f puts a fix on the prompt%f"
    print -r -- $(( n + 1 )) >| $ZSH_DATA/hint-count
  fi
  return 0
}
_zs_chpwd() {
  emulate -L zsh
  (( ZSH_CD_HINTS )) || return 0
  [[ -e .git || -f pyproject.toml || -f package.json || -f Cargo.toml || -f go.mod ]] || return 0

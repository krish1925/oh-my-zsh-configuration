# `foo.py` / `foo` → python foo.py; otherwise suggest near-misses (edit distance 1)
command_not_found_handler() {
  emulate -L zsh; setopt extendedglob
  local cmd=$1
  if [[ -f $cmd && $cmd == *.py ]]; then python "$cmd" "${@:2}"; return
  elif [[ -f $cmd.py ]]; then python "$cmd.py" "${@:2}"; return; fi
  print -u2 -r -- "zsh: command not found: $cmd"
  if (( $#cmd >= 3 )); then
    local -a near
    near=( ${(k)commands[(I)(#a1)$cmd]} ${(k)aliases[(I)(#a1)$cmd]} ${(k)functions[(I)(#a1)$cmd]} )
    near=( ${${(u)near}:#_*} )
    (( $#near )) && print -u2 -r -- "  did you mean: ${(j:  :)near[1,6]}"
  fi
  print -u2 -r -- "  or ask:  ? <what you were trying to do>"
  return 127
}


#!/usr/bin/env zsh
# =====================================================================
#  ZSH v4 — adaptive shell · Ghostty
#  black / semi-transparent background · 100% local by default
#
#  FILES
#    ~/.zshrc                  core (this file): speed, colors, plugins, hooks
#    ~/.config/zsh/ai.zsh      local LLM layer   (? / ?? / wtf / explain / aic)
#    ~/.config/zsh/habits.zsh  learning engine   (habits, smart suggestions)
#    ~/.config/zsh/tools.zsh   swiss-army knife  (zhelp lists everything)
#    ~/.config/zsh/supershell.zsh  click-to-move, shift-select, watcher, ciw
#    ~/.config/zsh/agents.zsh  background Claude Code jobs  (aj / ajs)
#    ~/.config/zsh/mcp/        shell-history MCP server for Claude Code
#    ~/.zshrc.local            your private overrides (never touched)
#
#  THE 6 THINGS TO REMEMBER
#    ? <what you want>    Enter → AI writes the command into your prompt (never runs it)
#    ?? <question>        Enter → AI answers in the terminal
#    wtf                  explain why the last command failed (+ fix on the prompt)
#    habits               turn what you actually type into shortcuts
#    Ctrl+N               pick from ALL ranked suggestions, not just the inline one
#    Ctrl+G               command palette: every function / alias / abbreviation
#    zhelp                cheat sheet          (zsh-doctor = health check)
#
#  WHAT CHANGED vs v3 (Sept 2026)
#    fixed  HIST_IGNORE_ALL_DUPS silently broke match_prev_cmd (sequence
#           learning needs history order) → removed
#    fixed  compinit -C fast path never ran: (#q…) needs EXTENDED_GLOB, which
#           was set *after* it → full compinit + audit on every start
#    fixed  `bindkey -e` ran after plugin bindings (lost in nested shells,
#           because EDITOR=nvim makes zsh default to vi keymap)
#    fixed  ls = eza --color=always → escape codes in pipes. now auto
#    fixed  fzf sourced after atuin → fzf owned Ctrl+R. atuin owns it now
#    speed  static antidote file (antidote itself no longer sourced),
#           tool inits cached to disk + keyed on the real binary path,
#           atuin/carapace/fnm deferred until after the first prompt
#    color  no ANSI blue/magenta anywhere; 24-bit high-luminance palette
#           for ls/eza, typed paths (F-Sy-H was magenta), p10k dir, fzf
#    smart  suggestions: sequence → directory+frequency+recency (atuin DB)
#           → history → completion
#    ai     kollzsh (reloads the model per keypress) → persistent local
#           OpenAI-compatible server, auto-start + idle shutdown
#
#  Profile startup:  ZPROFILE=1 zsh -i -c exit
# =====================================================================

# ---- 0. BOOT ---------------------------------------------------------
zmodload zsh/datetime
typeset -gF _ZS_T0=$EPOCHREALTIME
[[ -n $ZPROFILE ]] && zmodload zsh/zprof

setopt EXTENDED_GLOB INTERACTIVE_COMMENTS            # early: (#q…) qualifiers below need it
zmodload -F zsh/files b:zf_rm b:zf_mv b:zf_mkdir     # fork-free file ops
zmodload -F zsh/stat b:zstat
zmodload zsh/parameter

typeset -g ZSH_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/zsh
typeset -g ZSH_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
typeset -g ZSH_DATA=${XDG_DATA_HOME:-$HOME/.local/share}/zsh
[[ -d $ZSH_CACHE/completions && -d $ZSH_DATA && -d $ZSH_CONF ]] ||
  zf_mkdir -p $ZSH_CACHE/completions $ZSH_DATA $ZSH_CONF

# lib.zsh: locking, atomic writes, PID checks — every shared file below goes through it, because
# several terminals (and background jobs) start, write and regenerate these files at the same time
source $ZSH_CONF/lib.zsh 2>/dev/null || print -u2 "zsh config: $ZSH_CONF/lib.zsh is missing — shared files are unprotected"

# Behaviour switches — override any of these in ~/.zshrc.local
: ${ZSH_FAIL_HINT:=1}            # remind that `wtf` exists after failures (self-silences after 12)
: ${ZSH_CD_HINTS:=1}             # one-line project summary when you enter a repo
: ${ZSH_SMART_SUGGEST:=1}        # directory/frequency-aware autosuggestions from the atuin DB
: ${ZSH_NOTIFY_AFTER:=0}         # seconds; >0 = desktop notification when a long command ends
: ${ZSH_AUTO_UPDATE_PLUGINS:=0}  # 1 = weekly background `antidote update` (off: supply-chain caution)
: ${ZSH_SLOW_MS:=150}            # startup budget; the weekly check warns when the average exceeds it

# Console output has to happen BEFORE the instant-prompt block.
if [[ -s $ZSH_CACHE/tip ]]; then
  print -r -- "$(<$ZSH_CACHE/tip)"
  zf_rm -f $ZSH_CACHE/tip
fi
if [[ ! -e $ZSH_DATA/welcomed ]]; then
  print -r -- "zsh v4 loaded · first time: zsh-setup · cheat sheet: zhelp · palette: Ctrl+G · AI: ? <what you want>"
  : >| $ZSH_DATA/welcomed
fi

# ---- 1. INSTANT PROMPT -----------------------------------------------
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

bindkey -e   # FIRST: EDITOR=nvim would otherwise select the vi keymap and later bindings get lost

# ---- 2. PATH (only directories that exist) ---------------------------
typeset -U path fpath
path=(
  $HOME/.opencode/bin(N-/)
  $HOME/.codeium/windsurf/bin(N-/)
  /opt/homebrew/opt/openjdk/bin(N-/)
  /opt/homebrew/bin(N-/)
  /opt/homebrew/sbin(N-/)
  /usr/local/bin(N-/)
  $HOME/.local/bin(N-/)
  $HOME/bin(N-/)
  $HOME/.cargo/bin(N-/)
  $HOME/.antigravity/antigravity/bin(N-/)
  $HOME/google-cloud-sdk/bin(N-/)
  $path
)
export PATH

# ---- 3. ENVIRONMENT ---------------------------------------------------
export LANG=en_US.UTF-8
export EDITOR='nvim' VISUAL='nvim'
export LESS='-R -F -g -i -J -M -W -x4'
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export PYTORCH_ENABLE_MPS_FALLBACK=1
export CLICOLOR=1
WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'     # path segments are separate words

# ---- 4. COLORS — tuned for BLACK + SEMI-TRANSPARENT --------------------
# Rules for this background: nothing below ~55% luminance, no dark blue,
# no purple/magenta. Plenty of DISTINCT hues so file kinds stay scannable.
# Change a hex here and ls, eza, typed paths, prompt and fzf all follow.
typeset -gA ZC=(
  dir     '#7dcfff'   # folders              sky blue, bold
  exe     '#9ece6a'   # executables          green
  link    '#ffb86c'   # symlinks             orange
  archive '#f7768e'   # zip/tar/dmg          coral
  media   '#2ac3de'   # images/video/audio   cyan
  code    '#e0af68'   # source files         amber
  data    '#73daca'   # json/yaml/toml/csv   mint
  doc     '#c0caf5'   # md/txt/pdf           pale periwinkle
  text    '#cdd6f4'   # body text
  warn    '#f9e2af'   # devices, pipes       yellow
  err     '#ff7a93'   # broken links         bright red
  dim     '#9aa5ce'   # dates, punctuation   readable gray (fg=8 is not)
  acc     '#89ddff'   # accents: spinner, fzf info, global aliases (was referenced but never defined)
)
# For zsh-colors palette display (truecolor blocks) — keep 24-bit
_zs_rgb() { local h=${1#\#}; REPLY="38;2;$((16#${h[1,2]}));$((16#${h[3,4]}));$((16#${h[5,6]}))" }
# hex -> nearest xterm-256 SGR ("38;5;N"). Truecolor in LS_COLORS gets
# misparsed by eza (blue byte leaks as a bg code), so use 256 here.
_zs_q() { REPLY=$(( $1 < 48 ? 0 : $1 < 115 ? 1 : ($1 - 35) / 40 )) }
_zs_256() {
  local h=${1#\#} r g b ri gi bi gy gyi gv d1 d2
  local -a lv=(0 95 135 175 215 255)
  r=$((16#${h[1,2]})); g=$((16#${h[3,4]})); b=$((16#${h[5,6]}))
  _zs_q $r; ri=$REPLY; _zs_q $g; gi=$REPLY; _zs_q $b; bi=$REPLY
  gy=$(( (r + g + b) / 3 ))
  gyi=$(( gy > 238 ? 23 : gy > 3 ? (gy - 3) / 10 : 0 )); gv=$(( 8 + 10 * gyi ))
  d1=$(( (r-lv[ri+1])**2 + (g-lv[gi+1])**2 + (b-lv[bi+1])**2 ))
  d2=$(( (r-gv)**2 + (g-gv)**2 + (b-gv)**2 ))
  (( d1 <= d2 )) && REPLY="38;5;$(( 16 + 36*ri + 6*gi + bi ))" \
                 || REPLY="38;5;$(( 232 + gyi ))"
}

() {
  emulate -L zsh
  local -A C
  local k ext lsc
  for k in ${(k)ZC}; do _zs_256 $ZC[$k]; C[$k]=$REPLY; done

  # ---- LS_COLORS: read by BSD ls, GNU ls, eza, fzf-tab and zsh completion
  lsc="di=1;${C[dir]}:fi=${C[text]}:ln=${C[link]}:or=1;${C[err]}:mi=1;${C[err]}:ex=1;${C[exe]}"
  lsc+=":pi=${C[warn]}:so=${C[warn]}:bd=${C[warn]}:cd=${C[warn]}"
  lsc+=":su=1;${C[err]}:sg=1;${C[err]}:st=${C[dir]}:tw=${C[dir]}:ow=${C[dir]}"
  for ext in tar tgz taz gz bz2 xz zst zip 7z rar dmg pkg iso jar whl deb; do lsc+=":*.$ext=${C[archive]}"; done
  for ext in png jpg jpeg gif webp svg heic tiff bmp ico mp4 mov mkv avi webm mp3 wav flac m4a aac; do lsc+=":*.$ext=${C[media]}"; done
  for ext in py js ts jsx tsx rs go c h cpp hpp java rb php swift kt lua zsh sh bash fish sql ipynb; do lsc+=":*.$ext=${C[code]}"; done
  for ext in json yaml yml toml ini conf cfg env xml csv tsv parquet db sqlite lock; do lsc+=":*.$ext=${C[data]}"; done
  for ext in md markdown txt rst pdf doc docx rtf tex epub; do lsc+=":*.$ext=${C[doc]}"; done
  export LS_COLORS=$lsc

  # ---- EZA_COLORS: minimal + NO background/underline, readable on black
  # file colors come from LS_COLORS above; these just fix the UI chrome that
  # was unreadable (1;90m bright-black on black) and the header underline.
  export EZA_COLORS="hd=${C[dim]}:lp=${C[dim]}:cc=${C[dim]}:da=${C[dim]}:hd=${C[dim]}:xx=${C[dim]}:oc=${C[dim]}"
  EZA_COLORS+=":uu=${C[warn]}:gu=${C[dim]}:un=${C[err]}:gn=${C[err]}:sn=${C[exe]}:sb=${C[exe]}"
  EZA_COLORS+=":ur=${C[warn]}:uw=${C[err]}:ux=${C[exe]}:ue=${C[exe]}"
  EZA_COLORS+=":gr=${C[warn]}:gw=${C[err]}:gx=${C[exe]}:tr=${C[warn]}:tw=${C[err]}:tx=${C[exe]}"
  EZA_COLORS+=":ga=${C[exe]}:gm=${C[warn]}:gd=${C[err]}:cr=${C[warn]}:mp=${C[dim]}"
}
export LSCOLORS=GxFxCxDxBxegedabagacad   # BSD ls fallback: bold-cyan dirs, bold-green exe
unset CLICOLOR_FORCE                     # was export empty, which *forces* color into pipes (BSD checks existence)

# eza flag support differs by version; probe once and cache the result, so a
# too-old eza degrades to plain colors instead of erroring on every `ls`.
_zs_eza_flags() {
  local f=$ZSH_CACHE/eza-flags
  if [[ ! -s $f || ${commands[eza]:A} -nt $f ]]; then
    if eza --color=auto --icons=auto --version >/dev/null 2>&1; then
      print -r -- '--color=auto --icons=auto' >| $f
    elif eza --color=auto --icons --version >/dev/null 2>&1; then
      print -r -- '--color=auto --icons' >| $f
    else
      print -r -- '--color=auto' >| $f
    fi
  fi
  REPLY=$(<$f)
}

function zsh-colors {   # diagnose + preview. Run this if `ls` looks wrong.
  emulate -L zsh
  local k
  print -P "%Beza%b       ${commands[eza]:-NOT INSTALLED — \`ls\` falls back to BSD ls}"
  (( $+commands[eza] )) && print -P "%Bversion%b   $(eza --version 2>&1 | head -1)"
  _zs_eza_flags; print -P "%Bflags%b     ls = eza $REPLY --group-directories-first"
  print -P "%Balias ls%b  ${aliases[ls]:-<none: ls is not aliased>}"
  print -P "%BLS_COLORS%b ${#LS_COLORS} chars · %BEZA_COLORS%b ${#EZA_COLORS} chars"
  print -P "\n%Bpalette%b (if these are all white, your terminal is not doing 24-bit color)"
  for k in ${(ok)ZC}; do
    _zs_rgb $ZC[$k]
    printf '  \033[%sm%-9s %s  ████████\033[0m\n' "$REPLY" "$k" "$ZC[$k]"
  done
  if (( $+commands[eza] )); then
    print -P "\n%Braw eza test%b (forced color — if THIS is colorless, eza is rejecting the env vars)"
    eza --color=always -1 2>/dev/null | head -8
    print -P "\n%Bwith your flags%b"
    eza ${=REPLY} -1 2>/dev/null | head -8
  fi
  print -P "\n%Bterminal%b  TERM=$TERM COLORTERM=${COLORTERM:-<unset — Ghostty should set truecolor>}"
}

# line editor highlights
zle_highlight=('region:bg=#45475a,fg=#ffffff' 'paste:none' "isearch:fg=$ZC[warn],underline")   # quoted: '#' is a glob operator under EXTENDED_GLOB

# bat theme: use your custom Mocha file if present, else bat ≥0.25's built-in
() {
  local -a t=( ${XDG_CONFIG_HOME:-$HOME/.config}/bat/themes/**/*[Mm]ocha*.tmTheme(N) )
  if (( $#t )); then export BAT_THEME=${t[1]:t:r}; else export BAT_THEME='Catppuccin Mocha'; fi
}

# ---- 5. HISTORY (order-preserving — sequence learning depends on it) --
HISTFILE=$HOME/.zsh_history
HISTSIZE=200000
SAVEHIST=200000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_FCNTL_LOCK HIST_IGNORE_DUPS \
       HIST_FIND_NO_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY
# NOT set on purpose: HIST_IGNORE_ALL_DUPS / HIST_EXPIRE_DUPS_FIRST /
# HIST_SAVE_NO_DUPS. They delete older duplicates, which destroys both
# "what follows what" and frequency — the two signals this shell learns from.

# ---- 6. PLUGIN CONFIG (must precede plugin load) ----------------------
ZSH_AUTOSUGGEST_STRATEGY=(history completion)   # _zs_finalize upgrades this once habits.zsh is loaded
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=60
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=$ZC[dim]"
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_HISTORY_IGNORE='?(#c150,)'
ZSH_AUTOSUGGEST_MANUAL_REBIND=1      # perf; _zs_finalize re-binds once after everything loaded

ZSH_HIGHLIGHT_MAXLENGTH=512
typeset -gA FAST_HIGHLIGHT_STYLES
_zs_fsh_colors() {   # F-Sy-H defaults: path=magenta, comment=black, globbing=blue → all unreadable here
  local p
  for p in '' ${FAST_THEME_NAME:-default}; do
    FAST_HIGHLIGHT_STYLES[${p}path]="fg=$ZC[dir]"
    FAST_HIGHLIGHT_STYLES[${p}path-to-dir]="fg=$ZC[dir],underline"
    FAST_HIGHLIGHT_STYLES[${p}comment]="fg=$ZC[dim]"
    FAST_HIGHLIGHT_STYLES[${p}globbing]="fg=$ZC[warn],bold"
    FAST_HIGHLIGHT_STYLES[${p}history-expansion]="fg=$ZC[warn],bold"
    FAST_HIGHLIGHT_STYLES[${p}global-alias]="fg=$ZC[acc],bold"
  done
}
_zs_fsh_colors

export YSU_MESSAGE_POSITION='after' YSU_MODE=ALL
ABBR_QUIET=1
ABBR_GET_AVAILABLE_ABBREVIATION=1    # zsh-abbr: tell me when I typed out something I have an abbr for
ABBR_LOG_AVAILABLE_ABBREVIATION=1
export AUTOSWITCH_MESSAGE_FORMAT='venv: %venv_name (%py_version)'
export FORGIT_NO_ALIASES=true

# ---- 7. PLUGINS: antidote → one static file ---------------------------
# antidote itself is only sourced when plugins.txt changes. Normal startups
# source a single pre-generated file. Everything interactive is deferred
# (zsh-defer) and runs in list order after the first prompt is on screen.
typeset -g ZS_ANTIDOTE=/opt/homebrew/opt/antidote/share/antidote/antidote.zsh
zstyle ':antidote:bundle' use-friendly-names 'yes'

_zs_ptxt=$ZSH_CONF/plugins.txt
_zs_pzsh=$ZSH_CACHE/plugins.zsh
if [[ ! -f $_zs_ptxt ]]; then
  command cat > $_zs_ptxt <<'EOF'   # `command`: cat is aliased to bat further down
# Edit freely — the static bundle regenerates on next shell start.
romkatv/powerlevel10k
zsh-users/zsh-completions kind:fpath path:src

# deferred, IN THIS ORDER: fzf-tab after compinit and before widget wrappers;
# autosuggestions late; syntax highlighting after it; substring-search last.
Aloxaf/fzf-tab kind:defer
hlissner/zsh-autopair kind:defer
olets/zsh-abbr kind:defer
MichaelAquilina/zsh-you-should-use kind:defer
MichaelAquilina/zsh-autoswitch-virtualenv kind:defer
wfxr/forgit kind:defer
ohmyzsh/ohmyzsh path:plugins/sudo kind:defer
zsh-users/zsh-autosuggestions kind:defer
zdharma-continuum/fast-syntax-highlighting kind:defer
zsh-users/zsh-history-substring-search kind:defer
EOF
fi
# Regenerate under a lock, re-checking inside it: terminals opened together after a plugins.txt edit
# used to share ONE fixed temp filename and corrupt the bundle; now one regenerates, the others wait and reuse.
_zs_regen_plugins() {   # <plugins.txt> <bundle>
  [[ ! -s $2 || $1 -nt $2 ]] || return 0
  local tmp=$2.tmp.${sysparams[pid]}
  ( source $ZS_ANTIDOTE && antidote bundle < $1 >| $tmp ) && [[ -s $tmp ]] && zf_mv -f $tmp $2 || { zf_rm -f $tmp; return 1 }
}
if [[ ! -s $_zs_pzsh || $_zs_ptxt -nt $_zs_pzsh ]]; then
  if [[ -r $ZS_ANTIDOTE ]]; then
    _zs_locked -t 90 $_zs_pzsh _zs_regen_plugins $_zs_ptxt $_zs_pzsh ||
      print -u2 "plugin bundle could not be regenerated (kept the previous one, if any) — run: zup"
  else
    print -u2 "antidote missing → brew install antidote, then: exec zsh"
  fi
fi
unfunction _zs_regen_plugins
[[ -s $_zs_pzsh ]] && source $_zs_pzsh
unset _zs_ptxt _zs_pzsh
antidote() { unfunction antidote; source $ZS_ANTIDOTE && antidote "$@" }   # lazy

# ---- 8. HELPERS --------------------------------------------------------
# _zs_cached <name> <binary> <generator…>
#   Source the cached output of an init command (`zoxide init zsh` …).
#   Key = resolved binary path (the Cellar path contains the version), so a
#   `brew upgrade` invalidates it. mtime is NOT reliable for brew bottles.
_zs_cached() {
  local name=$1 exe=${commands[$2]} file=$ZSH_CACHE/init-$1.zsh first=''
  shift 2
  [[ -n $exe ]] || return 1
  local key="# key: ${exe:A} $*"
  [[ -r $file ]] && IFS= read -r first < $file
  if [[ $first != $key ]]; then
    # one shell regenerates, written whole (temp + rename) — a terminal starting at the same moment
    # used to source a half-written init script. A generator that fails keeps the previous good cache.
    _zs_locked -t 15 $file _zs_cache_regen $file $key "$@"
    [[ -r $file ]] || return 1
  fi
  source $file
}
_zs_cache_regen() {   # <file> <key> <generator…>   (under the lock; re-check in case another shell just did it)
  local file=$1 key=$2 first='' tmp=$1.tmp.${sysparams[pid]}; shift 2
  [[ -r $file ]] && IFS= read -r first < $file
  [[ $first == $key ]] && return 0
  if { print -r -- $key; "$@" } >| $tmp 2>/dev/null && [[ $(command wc -c < $tmp) -gt $(( ${#key} + 1 )) ]]; then     # ...and printed something beyond the key line
    zf_mv -f $tmp $file && zcompile $file 2>/dev/null
  else
    zf_rm -f $tmp; return 1
  fi
}
# _zs_later <zsh-defer args…> — run after the first prompt (or now, if zsh-defer is absent)
_zs_later() {
  if (( $+functions[zsh-defer] )); then zsh-defer "$@"
  elif [[ $1 == -c ]]; then eval "$2"
  else "$@"; fi
}

# ---- 9. COMPLETION -----------------------------------------------------
fpath=($ZSH_CACHE/completions $fpath)
autoload -Uz compinit
_zs_zcd=$ZSH_CACHE/zcompdump
if [[ -n $_zs_zcd(#qN.mh-20) ]]; then
  compinit -C -d $_zs_zcd                           # fresh dump: skip scan + security audit
else
  compinit -d $_zs_zcd; command touch $_zs_zcd      # touch: compinit leaves mtime alone if nothing changed
fi
unset _zs_zcd
_zs_later -c 'autoload -Uz bashcompinit && bashcompinit'

setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT CDABLE_VARS
setopt GLOB_DOTS NO_NOMATCH NUMERIC_GLOB_SORT
setopt COMPLETE_IN_WORD ALWAYS_TO_END AUTO_MENU LIST_PACKED
setopt NO_BEEP NO_FLOW_CONTROL MULTIOS RM_STAR_SILENT
unsetopt CORRECT CORRECT_ALL

zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' matcher-list \
  'm:{[:lower:][:upper:]-_}={[:upper:][:lower:]_-}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path $ZSH_CACHE/compcache
zstyle ':completion:*' list-suffixes
zstyle ':completion:*' expand prefix suffix
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:warnings' format '%F{red}-- no matches --%f'
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' menu no                       # fzf-tab owns the menu
zstyle ':completion:*:git-checkout:*' sort false

zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-flags '--height=60%'
zstyle ':fzf-tab:complete:(cd|z|ls|eza|ll|la|lt|bat|cat|nvim|vim|code|cp|mv|rm|del|open):*' fzf-preview \
  'if [[ -d $realpath ]]; then eza -1 --color=always --icons=always --group-directories-first $realpath; elif [[ -f $realpath ]]; then bat -n --color=always --line-range :200 $realpath 2>/dev/null; fi'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza --tree --level=2 --color=always $realpath'
zstyle ':fzf-tab:complete:(kill|ps):argument-rest' fzf-preview 'ps -p $word -o pid,user,%cpu,%mem,command 2>/dev/null'
zstyle ':fzf-tab:complete:(-command-|-parameter-|-brace-parameter-|export|unset|expand):*' fzf-preview 'echo ${(P)word}'

# ---- 10. TOOL INITS: cached (sync) or deferred -------------------------
if (( $+commands[fzf] )); then
  _zs_cached fzf fzf fzf --zsh
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix --exclude .git'
    export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
    export FZF_ALT_C_COMMAND='fd --type=d --hidden --strip-cwd-prefix --exclude .git'
    _fzf_compgen_path() { fd --hidden --exclude .git . "$1" }
    _fzf_compgen_dir()  { fd --type=d --hidden --exclude .git . "$1" }
  fi
  # bg:-1 / gutter:-1 → fzf stays transparent instead of painting a slab over the wallpaper
  export FZF_DEFAULT_OPTS="
    --height=80% --layout=reverse --border=rounded --info=inline-right

# ~/.config/ghostty/config      (macOS also reads:
#   ~/Library/Application Support/com.mitchellh.ghostty/config — if BOTH exist,
#   check which one you actually have; editing the wrong one is the usual reason
#   a Ghostty setting "does nothing")
#
# Reload after editing:  Cmd+Shift+, (or quit and reopen)

# ---- selection copies to the clipboard automatically -------------------------
# `true`  prefers the *selection* clipboard, which on macOS is NOT what Cmd+V reads.
# `clipboard` writes the real system clipboard, which is what you want.
copy-on-select = clipboard

# make the selection readable on a translucent background
selection-invert-fg-bg = false

# ---- readability on black + transparency --------------------------------------
# 1.6 was lifting dim text and adding background wash. 1.15 keeps it readable
# without painting a highlight behind every file type. Raise to 1.3 if needed.
minimum-contrast = 1.15

# your transparency — raise opacity if text still fights the wallpaper
background = #000000
background-opacity = 0.85
background-blur-radius = 20

# ---- supershell: the prompt behaves like a text field ---------------------------
# Click anywhere in the command you are typing → the cursor goes there.
# Needs shell integration (on by default: Ghostty injects it into zsh).
cursor-click-to-move = true
# Shift+drag selects text even when a program has grabbed the mouse
# (e.g. `zmouse on`, vim, fzf).
# Confirm before pasting something that contains a newline (would run it).
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
# Hide the mouse pointer while typing.
mouse-hide-while-typing = true
# Cmd+click opens URLs and file paths printed in the terminal.
link-url = true
# Drop-down terminal from anywhere (Ctrl+`), like a Quake console.
quick-terminal-position = top
keybind = global:ctrl+grave_accent=toggle_quick_terminal
# Jump between prompts in scrollback (needs shell integration).
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# ---- misc ---------------------------------------------------------------------
# keeps the block cursor without the workaround in .zshrc
shell-integration-features = no-cursor

# real Alt: makes Alt+B / Alt+F / Alt+C work like every other terminal
macos-option-as-alt = left

# =================================================================================
# COPYING TEXT WITHOUT `cat`'s LINE NUMBERS
#
# Line numbers from bat are ordinary characters on the screen, so any normal
# selection includes them. Three ways around it, best first:
#
#   1. Rectangular selection — hold Ctrl+Alt and drag. The cursor becomes a
#      crosshair and you select a COLUMN BLOCK, so you can grab the code and
#      leave the "  12 │" gutter behind. This is the one you want for
#      "show numbers, copy without them".
#
#   2. copy <file>          copies the whole file, clean. bat detects that it is
#                           not writing to a terminal and drops numbers, colors
#                           and the grid automatically — so `cat f | pbcopy`,
#                           `cat f > out` and `cat f | grep x` are all clean too.
#                           Only what you SEE has numbers.
#
#   3. catp <file>          same view, no numbers, if you would rather select
#                           normally for one file.
# =================================================================================
